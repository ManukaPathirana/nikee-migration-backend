# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development            # development | production
APP_NAME="Nikee Migrations API"
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://nikee:change-me@localhost:5432/nikee_migrations
TEST_DATABASE_URL=postgresql+asyncpg://nikee:change-me@localhost:5432/nikee_migrations_test

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=10
INVITE_EXPIRE_HOURS=72

# --- Seed admin ---
SEED_ADMIN_EMAIL=admin@nikeemigration.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME="Nikee Admin"

# --- Redis / background jobs ---
REDIS_URL=redis://localhost:6379/0

# --- Email ---
EMAIL_BACKEND=console          # console | file | smtp | resend
EMAIL_FROM="Nikee Migrations <no-reply@nikeemigration.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=

# --- Storage ---
STORAGE_BACKEND=local          # local | s3
LOCAL_STORAGE_DIR=./storage
SIGNED_URL_EXPIRE_SECONDS=300
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
