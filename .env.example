# Copy to .env and fill in real values. Never commit .env.

# --- App ---
# development | production | test
APP_ENV=development
APP_NAME="Nikee Migrations API"
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# IANA timezone used for times in emails
BUSINESS_TIMEZONE=Asia/Colombo

# --- Database ---
DATABASE_URL=postgresql+asyncpg://nikee:change-me@localhost:5432/nikee_migrations
# Supabase example (session pooler, needs ssl=require):
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres?ssl=require
TEST_DATABASE_URL=postgresql+asyncpg://nikee:change-me@localhost:5432/nikee_migrations_test

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
INVITE_EXPIRE_HOURS=72
RATE_LIMIT_ENABLED=true

# --- Seed data ---
SEED_ADMIN_EMAIL=admin@nikeemigration.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME="Nikee Admin"
# Password for the demo staff + demo customer accounts (development only)
SEED_DEMO_PASSWORD=change-me

# --- Background jobs ---
# Empty = run jobs (emails, meeting reminders) as in-process background tasks (local dev, no Redis).
# Set it (e.g. redis://localhost:6379/0) to enqueue jobs to arq; production and Docker Compose always set it.
REDIS_URL=

# --- Email ---
# console = log only | file = write .eml files to DEV_MAIL_DIR | smtp | resend
EMAIL_BACKEND=console
EMAIL_FROM="Nikee Migrations <no-reply@nikeemigration.com>"
DEV_MAIL_DIR=./dev_mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=

# --- Push notifications (optional) ---
# Firebase project id + path to a service-account JSON. Leave empty to disable push
# (in-app notifications still work). Enabling also needs: pip install google-auth
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=

# --- Storage ---
# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
SIGNED_URL_EXPIRE_SECONDS=300
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
